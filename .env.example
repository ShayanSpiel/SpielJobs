# Backend: optional interpretation; keywords work without a model.
MISTRAL_API_KEY=
GEMINI_API_KEY=
MISTRAL_MODEL=ministral-3b-2512
GEMINI_MODEL=gemini-2.5-flash-lite
# Observability: no raw resume contents are recorded.
SPIELJOBS_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional deployment commit; defaults to the runtime fingerprint.
LANGFUSE_RELEASE=
# Configure a shared quota for production. Redis also shares employer snapshots.
SPIELJOBS_SUPABASE_QUOTA_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SPIELJOBS_REQUESTS_PER_MINUTE=10
SPIELJOBS_GLOBAL_REQUESTS_PER_MINUTE=120
SPIELJOBS_MAX_CONCURRENT_REQUESTS=4
SPIELJOBS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://job.spielos.xyz
# Frontend Vercel environment: deploy backend first and set its HTTPS origin.
SPIELJOBS_API_URL=

# Dedicated SpielJobs PostHog project; leave blank until provisioned.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_UI_HOST=
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
